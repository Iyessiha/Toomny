{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "cdg1"
  ],
  "crons": [
    {
      "path": "/api/cron/auto-release",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/boost-reminders",
      "schedule": "0 10 * * 1,4"
    },
    {
      "path": "/api/cron/support-cleanup",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/support-retention",
      "schedule": "45 4 * * *"
    },
    {
      "path": "/api/cron/order-payment-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/order-auto-cancel",
      "schedule": "30 7 * * *"
    }
  ]
}
