# ---------------------------------------------------------------
# Toomny — variables d'environnement
# Copier en .env.local et remplir. Ne jamais committer .env.local.
# ---------------------------------------------------------------

# --- Base de données (Supabase / Postgres)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# --- Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Application
NEXT_PUBLIC_SITE_URL=https://toomny.com
NEXT_PUBLIC_APP_URL=https://toomny.com
NEXT_PUBLIC_DEFAULT_LOCALE=fr
NEXT_PUBLIC_DEFAULT_CURRENCY=XOF

# --- GeniusPay (https://geniuspay.ci/docs/api)
# Encaissement uniquement : l'API marchand n'expose pas de payout.
# Le versement aux prestataires reste un point ouvert du MVP.
GENIUSPAY_API_URL=https://geniuspay.ci/api/v1/merchant
GENIUSPAY_API_KEY=pk_sandbox_xxxxx
GENIUSPAY_SECRET=
GENIUSPAY_WEBHOOK_SECRET=

# --- Partenaire agréé de rétention de fonds (à confirmer : CinetPay / PayDunya / EME)
ESCROW_PARTNER=
ESCROW_PARTNER_ACCOUNT_ID=

# --- Anti-abus (Cloudflare Turnstile). Créer le site sur dash.cloudflare.com → Turnstile.
# Sans ces clés, le CAPTCHA est désactivé : à configurer avant la mise en production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Tâche planifiée (validation auto à 72 h). Vercel crée CRON_SECRET seul et
# l'envoie en Bearer sur les appels planifiés. En local, définir une valeur
# quelconque pour tester : curl -H "Authorization: Bearer <valeur>" /api/cron/auto-release
CRON_SECRET=

# --- Email transactionnel (Resend — https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxx
