# ---------------------------------------------------------------
# Toomny — variables d'environnement
# Copier en .env.local et remplir. Ne jamais committer .env.local.
# ---------------------------------------------------------------

# --- Base de données (Supabase / Postgres)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# --- Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Application
NEXT_PUBLIC_SITE_URL=https://toomny.com
NEXT_PUBLIC_DEFAULT_LOCALE=fr
NEXT_PUBLIC_DEFAULT_CURRENCY=XOF

# --- GeniusPay (encaissement + versement mobile money)
# Le séquestre est porté par le partenaire agréé, jamais par Toomny.
# Voir l'étude de marché, section « Contrainte réglementaire BCEAO ».
GENIUSPAY_API_URL=
GENIUSPAY_API_KEY=
GENIUSPAY_WEBHOOK_SECRET=

# --- Partenaire agréé de rétention de fonds (à confirmer : CinetPay / PayDunya / EME)
ESCROW_PARTNER=
ESCROW_PARTNER_ACCOUNT_ID=
